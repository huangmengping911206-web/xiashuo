/**
 * static/js/module.chat.js
 * 聊天业务模块 (已修复字段名、引用和结构问题)
 */

console.log('>>> [Debug] module.chat.js 开始加载');

window.AppChat = {
    // ===============================
    // 1. 状态定义
    // ===============================
    conversations: [],       // 会话列表
    currentChat: null,       // 当前聊天对象
    messages: [],            // 当前聊天消息列表
    newMessage: '',          // 输入框内容
    chatMessages: [],        // 调试用：收到的原始消息
    isLoadingMessages: false, // 【新增】防止重复请求的锁
    userAvatarCache: {}, // 用户头像缓存：{ userId: avatarUrl }

    // 弹窗与搜索状态
    showCreateGroup: false,
    showAddMember: false,
    searchKeyword: '',
    searchResults: [],
    selectedUsers: [],
    newGroupName: '',

    // ===============================
    // 2. 初始化与 WebSocket 集成
    // ===============================
    initChat: function() {
        console.log('[Chat] initChat 执行了');

        // 监听连接成功
        window.addEventListener('ws-connected', () => {
            console.log('[Chat] WebSocket 已连接');
            // 这里可以做一些连接后的操作，比如获取在线状态等
        });

        // 监听收到消息
        window.addEventListener('ws-message', (e) => {
            // e.detail 是解析后的 JSON 对象: { event: "send_message", data: {...} }
            console.log('[Chat] 收到原始推送:', e.detail);
            this.chatMessages.push(e.detail); // 存入调试日志

            // 调用处理函数
            this.handleIncomingMessage(e.detail);
        });

        // 启动连接
        if (this.token) {
            window.WS.connect(this.token);
        }
    },

    // ===============================
    // 3. 会话列表逻辑
    // ===============================
    async loadConversations() {
        try {
            const res = await this.api('/v2/chat/conversations');
            this.conversations = res.data || [];
        } catch (error) {
            console.error('[Load Conversations Error]', error);
        }
    },

    async openChat_old(conv) {
        this.currentChat = conv;
        this.page = 'chat_detail';
        this.pageHistory.push('chat_detail');
        this.messages = []; // 清空旧消息
        await this.loadMessages(conv.id, 0);
    },

    async openChat(conv) {
        this.currentChat = conv;
        this.page = 'chat_detail';
        this.pageHistory.push('chat_detail');
        this.messages = [];

        // 加载消息
        await this.loadMessages(conv.id, 0);

        // 【新增】设置滚动监听，等待 DOM 渲染完成
        this.$nextTick(() => {
            this.setupScrollListener();
        });
    },

    setupScrollListener() {
        const container = document.getElementById('chat-messages-container');
        if (!container) return;

        // 使用 onscroll 覆盖，避免重复添加监听器
        container.onscroll = () => {
            // 1. 判断是否滑到顶部 (预留 50px 缓冲)
            if (container.scrollTop < 50) {
                // 2. 确保有消息且不在加载中
                if (this.messages.length > 0 && !this.isLoadingMessages) {
                    // 3. 获取当前最早消息的 ID
                    const oldestMsgId = this.messages[0].id;
                    console.log('[Chat] 触发加载更早消息, before_id:', oldestMsgId);

                    // 4. 调用加载方法
                    this.loadMessages(this.currentChat.id, oldestMsgId);
                }
            }
        };
    },

    async loadMessages_old(convId, beforeId = 0) {
        try {
            // 注意：这里假设 API 返回的是列表，如果不是请根据实际情况调整
            const res = await this.api(`/v2/chat/conversations/${convId}/messages?before_id=${beforeId}&limit=20`);
            // 兼容处理：如果返回的是对象 {data: [...]}，取 data；否则直接用 res
            let msgList = (res && res.data) ? res.data : (res || []);

            // 【核心修复】数据标准化：如果后端没返回 type，前端默认补全为 'text'
            msgList = msgList.map(msg => ({
                ...msg,
                type: msg.type || 'text' // 缺少 type 时默认为文本消息
            }));

            if (beforeId > 0) {
                this.messages = [...msgList, ...this.messages];
            } else {
                this.messages = msgList;
            }

            this.$nextTick(() => this.scrollToBottom());
        } catch (error) {
            console.error('[Load Messages Error]', error);
        }
    },

    async loadMessages(convId, beforeId = 0) {
            if (this.isLoadingMessages) return; // 防止重复加载
            this.isLoadingMessages = true;

            try {
                const res = await this.api(`/v2/chat/conversations/${convId}/messages?before_id=${beforeId}&limit=20`);
                let msgList = (res && res.data) ? res.data : (res || []);

                // 数据标准化：补全 type 字段
                msgList = msgList.map(msg => ({
                    ...msg,
                    type: msg.type || 'text'
                }));

                // === 核心修改：处理排序 ===
                // 假设后端返回 [新 -> 旧]
                // 1. 反转数组，变成 [旧 -> 新]，这样最新消息就在底部
                msgList.reverse();

                if (beforeId === 0) {
                    // 首次加载：直接赋值
                    this.messages = msgList;
                    // 滚动到底部
                    this.$nextTick(() => this.scrollToBottom());
                } else {
                    // 加载更早记录：插入到头部
                    // 保存当前滚动位置，防止跳动
                    const container = document.getElementById('chat-messages-container');
                    const oldScrollHeight = container.scrollHeight;

                    // 插入数据
                    this.messages = [...msgList, ...this.messages];

                    // 恢复滚动位置（关键：保持视图相对位置不变）
                    this.$nextTick(() => {
                        const newScrollHeight = container.scrollHeight;
                        // 新增了多少高度，就往下滚动多少，这样用户视角的内容不变
                        container.scrollTop = newScrollHeight - oldScrollHeight;
                    });
                }
            } catch (error) {
                console.error('[Load Messages Error]', error);
            } finally {
                this.isLoadingMessages = false;
            }
        },
    // ===============================
    // 4. 消息发送逻辑 (关键修复)
    // ===============================
    async sendMessage() {
        if (!this.newMessage.trim() || !this.currentChat) return;

        const content = this.newMessage;
        this.newMessage = ''; // 立即清空输入框

        // 【修复1】构造符合后端要求的完整结构 { event: ..., data: ... }
        const payload = {
            event: "send_message", // 后端要求的字段名是 event，不是 action
            data: {
                conversation_id: this.currentChat.id,
                content: content,
                type: 'text'
            }
        };

        // 【修复2】调用正确的全局对象 window.WS
        const sent = window.WS.send(payload);

        if (!sent) {
            this.showToast('连接已断开，正在重连...', 'error');
            // 此处可以加入重发逻辑
        }
    },

    async sendImage(event) {
        const file = event.target.files[0];
        if (!file) return;

        const formData = new FormData();
        formData.append('file', file);

        try {
            // 假设上传接口返回 { id: ... }
            const res = await this.api('/v2/image/upload', 'POST', formData, true);

            // 【修复3】发送图片消息也要遵循结构
            const payload = {
                event: "send_message",
                data: {
                    conversation_id: this.currentChat.id,
                    content: res.id.toString(), // 发送图片ID
                    type: 'image'
                }
            };

            window.WS.send(payload);
        } catch (error) {
            this.showToast('图片上传失败', 'error');
        }
        event.target.value = ''; // 清空 input
    },

    // ===============================
    // 5. 接收消息处理 (关键修复)
    // ===============================
    handleIncomingMessage_buackup_1(msgWrapper) {
        // 过滤非消息事件
        if (msgWrapper.event !== 'send_message') return;

        // 【修复4】从 wrapper 中提取真实的消息数据
        const msgData = msgWrapper.data;

        // 如果是当前聊天窗口的消息，添加到视图
        if (this.currentChat && msgData.conversation_id === this.currentChat.id) {
            this.messages.push(msgData);
            this.$nextTick(() => this.scrollToBottom());
        }

        // 更新会话列表预览
        const conv = this.conversations.find(c => c.id === msgData.conversation_id);
        if (conv) {
            conv.last_message = msgData.content;
            conv.last_message_time = msgData.created_at;
            // 如果不在当前聊天窗口，增加未读数
            if (!this.currentChat || msgData.conversation_id !== this.currentChat.id) {
                conv.unread_count = (conv.unread_count || 0) + 1;
            }
        }
    },

    // ===============================
    // 5. 接收消息处理 (关键修复)
    // ===============================
    handleIncomingMessage_buckup_2(msgWrapper) {
        // 过滤非消息事件
        if (msgWrapper.event !== 'send_message') return;

        // 1. 提取数据
        const msgData = msgWrapper.msg_data;

        // 【关键修复】2. 数据标准化
        // 后端可能不返回 type 字段，必须补全，否则模板 x-show 判断会失效
        if (!msgData.type) {
            msgData.type = 'text';
        }

        // 同样确保其他必要字段存在，防止模板报错
        if (!msgData.sender_name) msgData.sender_name = '未知用户';

        // 3. 如果是当前聊天窗口的消息，添加到视图
        if (this.currentChat && msgData.conversation_id === this.currentChat.id) {
            this.messages.push(msgData);
            this.$nextTick(() => this.scrollToBottom());
        }

        // 4. 更新会话列表预览
        const conv = this.conversations.find(c => c.id === msgData.conversation_id);
        if (conv) {
            conv.last_message = msgData.content;
            conv.last_message_time = msgData.created_at;
            // 如果不在当前聊天窗口，增加未读数
            if (!this.currentChat || msgData.conversation_id !== this.currentChat.id) {
                conv.unread_count = (conv.unread_count || 0) + 1;
            }
        }
    },

    handleIncomingMessage(msgWrapper) {
        // 1. 过滤非消息事件
        if (msgWrapper.event !== 'send_message') return;

        // 2. 提取数据 (注意后端字段名是 msg_data)
        const msgData = msgWrapper.msg_data;
        if (!msgData) return;

        // 3. 数据标准化 (补全 type)
        if (!msgData.type) {
            msgData.type = 'text';
        }

        // 【调试日志】打印类型，方便排查
        console.log('[Chat] 消息会话ID:', msgData.conversation_id, typeof msgData.conversation_id);
        console.log('[Chat] 当前会话ID:', this.currentChat?.id, typeof this.currentChat?.id);

        // 4. 判断是否当前窗口
        // 【关键修复】使用 == 进行比较，兼容 数字4 和 字符串"4"
        const isCurrentChat = this.currentChat && (msgData.conversation_id == this.currentChat.id);

        if (isCurrentChat) {
            // 5. 去重：防止重复显示
            const exists = this.messages.some(m => m.id == msgData.id);
            if (!exists) {
                console.log('[Chat] 添加新消息到界面');
                this.messages.push(msgData);
                this.$nextTick(() => this.scrollToBottom());
            } else {
                console.log('[Chat] 消息已存在，不重复添加');
            }
        } else {
             console.log('[Chat] 消息不属于当前窗口，忽略');
        }

        // 6. 更新会话列表 (使用 == 比较)
        const conv = this.conversations.find(c => c.id == msgData.conversation_id);
        if (conv) {
            conv.last_message = msgData.content;
            conv.last_message_time = msgData.created_at;
            // 如果不在当前聊天窗口，增加未读数
            if (!isCurrentChat) {
                conv.unread_count = (conv.unread_count || 0) + 1;
            }
        }
    },

    scrollToBottom() {
        const container = document.getElementById('chat-messages-container');
        if (container) {
            container.scrollTop = container.scrollHeight;
        }
    },

    // ===============================
    // 6. 辅助功能 (搜索/群聊)
    // ===============================
    async searchUsers() {
        if (!this.searchKeyword.trim()) {
            this.searchResults = [];
            return;
        }
        try {
            const res = await this.api(`/v2/chat/users/search?keyword=${encodeURIComponent(this.searchKeyword)}`);
            this.searchResults = res.data || [];
        } catch (error) {
            console.error('[Search Users Error]', error);
        }
    },

    // ===============================
    // 7. 辅助工具 (修改与新增)
    // ===============================

    /**
     * 获取单个头像 URL;启用
     */
    getUserAvatar_chat(avatarId) {  //启用
        if (!avatarId) return '/static/img/default-avatar.png';
        return `/api/v2/image/${avatarId}`;
    },
    /**
     * 根据用户ID获取头像 (带缓存，支持异步加载)
     * 使用场景：<img :src="getUserAvatar_by_userid(user.id)">
     */
    getUserAvatar_by_userid(userId) {
        // 0. 参数校验
        if (!userId) return '/static/img/default-avatar.png';

        // 1. 如果缓存中有，直接返回 (同步)
        if (this.userAvatarCache[userId]) {
            return this.userAvatarCache[userId];
        }

        // 2. 如果缓存中没有，先返回默认头像 (同步，保证 img.src 有值)
        // 同时发起异步请求去获取真实头像
        this.fetchAndCacheUserAvatar(userId);

        return '/static/img/default-avatar.png';
    },

    /**
     * 异步获取用户信息并更新缓存
     */
    async fetchAndCacheUserAvatar(userId) {
        // 防止重复请求：如果正在请求中，可以加锁，这里简单处理
        try {
            // 调用你提供的接口
            const res = await this.api(`/v2/users/get/${userId}`);

            if (res && res.avatar_id) {
                // 构造头像 URL
                const url = `/api/v2/image/${res.avatar_id}`;

                // 【关键】更新缓存
                // Alpine.js 监听不到对象属性的直接增加，建议用这种方式赋值
                this.userAvatarCache[userId] = url;

                // 强制触发视图更新 (如果 Alpine 没有自动检测到变化)
                // this.$forceUpdate ? this.$forceUpdate() : null;
                // 在 Alpine 中，通常直接赋值对象属性也能触发更新，如果没有，可以打印日志查看
                console.log(`[Cache] 更新用户 ${userId} 头像:`, url);
            }
        } catch (error) {
            console.error(`获取用户 ${userId} 头像失败:`, error);
        }
    },



    /**
     * 【新增】获取会话列表的头像 HTML
     * 支持：单人头像、群聊组合头像
     */
    getConversationAvatarHtml_old_back(conv) {
        // 1. 获取成员数据 (依赖后端返回的 other_members)
        // 2. 如果是私聊且有成员数据 -> 显示对方头像
        if (conv.type === 'private' && members.length > 0) {
            const avatarUrl = this.getUserAvatar(members[0].avatar_id);
            return `<img src="${avatarUrl}" class="chat-avatar chat-avatar-lg">`;
        }

        // 3. 如果是群聊 -> 生成九宫格头像
        if (conv.type === 'group' && members.length > 0) {
            // 限制最多显示 9 个
            const displayMembers = members.slice(0, 9);
            const gridClass = this.getGridClass(displayMembers.length);

            let itemsHtml = displayMembers.map(m =>
                `<img src="${this.getUserAvatar(m.avatar_id)}" class="grid-img">`
            ).join('');

            return `<div class="avatar-grid ${gridClass}">${itemsHtml}</div>`;
        }

        // 4. 兜底：默认图
        return `<img src="/static/img/default-group.png" class="chat-avatar chat-avatar-lg">`;
    },

    /**
     * 获取会话列表头像 HTML
     * 逻辑：解析 member_ids_str，通过 ID 异步加载头像
     */
        /**
     * 获取会话头像 URL
     * 仅保留私聊逻辑，群聊返回默认图片
     */
    getConversationAvatar(conv) {
        // 1. 私聊逻辑：解析 member_ids_str 获取对方头像
        if (conv.type === 'private' && conv.member_ids_str) {
            // 解析 ID 字符串 "2,3" -> [2, 3]
            const userIds = conv.member_ids_str
                .split(',')
                .map(id => parseInt(id.trim()))
                .filter(id => id);

            // 如果有成员 ID，取第一个（对方）的 ID 获取头像
            if (userIds.length > 0) {
                // 这里返回的是 URL 字符串
                return this.getUserAvatar_by_userid(userIds[0]);
            }

        }

        // 2. 群聊兜底：返回默认群聊图片
        return this.getUserAvatar_by_userid(2);
    },



    toggleSelectUser(user) {
        const index = this.selectedUsers.findIndex(u => u.id === user.id);
        if (index >= 0) {
            this.selectedUsers.splice(index, 1);
        } else {
            this.selectedUsers.push(user);
        }
    },

    isSelected(user) {
        return this.selectedUsers.some(u => u.id === user.id);
    },

    openCreateGroupModal() {
        this.searchKeyword = '';
        this.searchResults = [];
        this.selectedUsers = [];
        this.newGroupName = '';
        this.showCreateGroup = true;
    },

    async createGroup() {
        if (this.selectedUsers.length === 0) {
            this.showToast('请至少选择一位成员', 'error');
            return;
        }
        try {
            const userIds = this.selectedUsers.map(u => u.id);
            await this.api('/v2/chat/conversations/group', 'POST', userIds);
            this.showToast('群聊创建成功', 'success');
            this.showCreateGroup = false;
            this.loadConversations();
        } catch (error) {
            this.showToast('创建失败: ' + error.message, 'error');
        }
    },

    openAddMemberModal() {
        this.searchKeyword = '';
        this.searchResults = [];
        this.selectedUsers = [];
        this.showAddMember = true;
    },

    async addMembers() {
        if (this.selectedUsers.length === 0) {
            this.showToast('请选择要添加的成员', 'error');
            return;
        }
        try {
            const userIds = this.selectedUsers.map(u => u.id);
            await this.api(`/v2/chat/conversations/${this.currentChat.id}/members`, 'POST', userIds);
            this.showToast('成员添加成功', 'success');
            this.showAddMember = false;
        } catch (error) {
            this.showToast('添加失败: ' + error.message, 'error');
        }
    }
};

// ===============================
// WebSocket 工具定义 (确保在 AppChat 之后或独立文件中)
// ===============================
window.WS_backup = { // 重复定义，先删了
    socket: null,
    isConnected: false,

    connect(token) {
        if (this.socket && this.socket.readyState === WebSocket.OPEN) return;

        const protocol = location.protocol === 'https:' ? 'wss:' : 'ws:';
        // 确保路径正确
        const url = `${protocol}//${location.host}/api/v2/chat/ws`;

        console.log('[WS] 正在连接...', url);
        this.socket = new WebSocket(url);

        this.socket.onopen = () => {
            console.log('[WS] 连接成功');
            this.isConnected = true;
            window.dispatchEvent(new CustomEvent('ws-connected'));
        };

        this.socket.onmessage = (event) => {
            try {
                const msg = JSON.parse(event.data);
                window.dispatchEvent(new CustomEvent('ws-message', { detail: msg }));
            } catch (e) {
                console.error('[WS] 解析失败', e);
            }
        };

        this.socket.onclose = () => {
            console.log('[WS] 连接断开，尝试重连...');
            this.isConnected = false;
            setTimeout(() => this.connect(token), 3000);
        };

        this.socket.onerror = (err) => {
            console.error('[WS] 错误', err);
        };
    },

    // 这里的 send 方法接受完整的 payload (包含 event 和 data)
    send(payload) {
        if (!this.isConnected) {
            console.warn('[WS] 未连接，无法发送');
            return false;
        }
        const jsonStr = JSON.stringify(payload);
        this.socket.send(jsonStr);
        return true;
    }
};

console.log('>>> [Debug] module.chat.js 加载完毕');
